# ── Required ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexaloop
JWT_SECRET=REPLACE_THIS_BEFORE_RUNNING_DO_NOT_USE_DEFAULT
PORT=3001
WEB_URL=http://localhost:3000

# ── File storage ─────────────────────────────────────────────────
# Leave AWS_S3_BUCKET empty for local file uploads (development).
# Set it to enable S3 storage (production).
AWS_S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email notifications ──────────────────────────────────────────
# Set EMAIL_PROVIDER=resend and add your Resend API key.
# Leave blank for dev-mode console logging.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=N.E.X.A Loop <noreply@nexaloop.app>

# ── Production only ──────────────────────────────────────────────
# NODE_ENV=production
# Generate JWT_SECRET: openssl rand -base64 48
